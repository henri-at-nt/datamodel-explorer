{
  "name": "datamodel-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive explorer for the Nexthink NQL data model and store model",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "shared",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w web",
    "start": "node scripts/start.mjs",
    "typecheck": "npm run typecheck -w shared -w server -w web",
    "test": "npm run test -w server",
    "e2e": "node scripts/e2e.mjs",
    "check:shutdown": "node scripts/check-shutdown.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.14.3",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.0"
  }
}
